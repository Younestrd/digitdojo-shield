[Unit]
Description=DigitDojo Shield security daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/shieldd -config /etc/digitdojo-shield/config.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
